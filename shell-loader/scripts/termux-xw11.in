#!/data/data/@EMBEDDED_APPLICATION_ID@/files/usr/bin/bash
if [ ! -e /system/bin/getprop ] || [ ! -e /system/bin/app_process ]; then
  echo "Headless system detected. Termux-XW11 requires standard Android to work,"
  echo "and depends on APKs and system properties."
  echo "If you are using termux-docker, the 'vncserver' command"
  echo "from 'pkg install tigervnc' is recommended instead."
  exit 1
fi
if [ "$(getprop ro.build.version.sdk)" -lt "24" ]; then
  echo "Termux-XW11 requires at least Android 7 or newer."
  echo "Please upgrade your Android device."
  echo "If you cannot upgrade, the 'vncserver' command"
  echo "from 'pkg install tigervnc' is recommended instead."
  exit 1
fi
[ -z "${LD_LIBRARY_PATH+x}" ] || export XSTARTUP_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
[ -z "${LD_PRELOAD+x}" ] || export XSTARTUP_LD_PRELOAD="$LD_PRELOAD"
[ -z "${CLASSPATH+x}" ] || export XSTARTUP_CLASSPATH="$CLASSPATH"

# Explicitly route sessions through the native Weston/XWayland -> Android Surface
# presenter. Keep the legacy entry point available until packaged dependencies
# and device-side first-frame presentation are verified on all supported builds.
if [ "${TERMUX_XW11_BACKEND:-legacy}" = "wayland" ]; then
  WAYLAND_LAUNCHER="@PREFIX@/bin/termux-xw11-wayland"
  if [ ! -x "$WAYLAND_LAUNCHER" ]; then
    echo "ERROR: native XWayland launcher is missing: $WAYLAND_LAUNCHER" >&2
    echo "Install/update the Termux-XW11 package containing termux-xw11-wayland." >&2
    exit 127
  fi
  # The Wayland supervisor owns Weston/XWayland and the output IPC handshake.
  # Do not start the legacy Loader/Lorie renderer in parallel.
  exec "$WAYLAND_LAUNCHER" start
fi
export CLASSPATH=/data/data/@EMBEDDED_APPLICATION_ID@/files/usr/libexec/termux-xw11/loader.apk
unset LD_LIBRARY_PATH LD_PRELOAD
[ -n "$(trap -p USR1)" ] && export TERMUX_X11_NOTIFY_PARENT=1

# Android 10+ can block an Activity launch initiated indirectly by the
# background app_process broadcast receiver. Open the default display UI
# explicitly from the user's Termux command; MainActivity retries connection
# while the native server initializes. Set TERMUX_XW11_NO_AUTO_ACTIVITY=1 for
# headless/server-only sessions.
if [ "${TERMUX_XW11_NO_AUTO_ACTIVITY:-0}" != "1" ]; then
  has_tag=0
  for arg in "$@"; do
    if [ "$arg" = "-tag" ]; then
      has_tag=1
      break
    fi
  done
  if [ "$has_tag" -eq 0 ]; then
    if ! am start -n "@APPLICATION_ID@/com.termux.x11.MainActivity" >/dev/null 2>&1; then
      echo "WARNING: could not open the Termux-XW11 display Activity; the native server will still start." >&2
      echo "Try: am start -n @APPLICATION_ID@/com.termux.x11.MainActivity" >&2
    fi
  fi
fi
exec /system/bin/app_process -Xnoimage-dex2oat / --nice-name="termux-xw11 @APPLICATION_ID@ $*" com.termux.x11.Loader "$@"
